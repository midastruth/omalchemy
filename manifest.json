{
  "schemaVersion": 1,
  "id": "midas.omalchemy",
  "name": "omalchemy",
  "version": "1.1.1",
  "author": "midas",
  "license": "MIT",
  "description": "Shows normalized tmux-argos agent state in the Omarchy bar and a keyboard-driven panel.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "omalchemy",
    "description": "Pi, Codex, and Claude state from tmux-argos, with tmux session jumping.",
    "category": "AI",
    "aliases": ["omalchemy", "agents", "tmux-argos"],
    "allowMultiple": false,
    "defaults": {
      "stateFile": "~/.cache/tmux-argos/state.json",
      "pollIntervalMs": 2000,
      "showCount": true,
      "notifications": true
    },
    "schema": [
      {
        "key": "stateFile",
        "type": "path",
        "label": "tmux-argos state file",
        "defaultValue": "~/.cache/tmux-argos/state.json"
      },
      {
        "key": "pollIntervalMs",
        "type": "integer",
        "label": "Fallback reload interval (milliseconds)",
        "min": 1000,
        "max": 60000,
        "step": 1000,
        "defaultValue": 2000
      },
      {
        "key": "showCount",
        "type": "boolean",
        "label": "Show agent count",
        "description": "Show the dominant state count next to the status icon.",
        "defaultValue": true
      },
      {
        "key": "notifications",
        "type": "boolean",
        "label": "Enable notifications",
        "description": "Notify when an agent becomes blocked or done.",
        "defaultValue": true
      }
    ]
  }
}
